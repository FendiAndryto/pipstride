---
// OnboardingSteps.astro - Redesigned Visual Onboarding Flow (Lively, Clean, Modern)
---

<section class="section onboarding-section" id="how-it-works">
  <!-- Soft Ambient Glow -->
  <div class="radial-glow-emerald onboarding-glow" aria-hidden="true"></div>

  <div class="site-container">
    <div class="section-header text-center reveal-on-scroll">
      <span class="section-tag mono">FRICTIONLESS SETUP</span>
      <h2 class="section-title">Up and running in 30 seconds.</h2>
      <p class="section-desc mx-auto">
        Zero VPS complexity, zero DLL imports, and zero trading passwords needed. Three intuitive steps to full institutional clarity.
      </p>
    </div>

    <!-- 3 Modern Visual Step Cards (No gloomy boxes, no weird subway line) -->
    <div class="steps-flow-grid">
      <!-- Step 1 -->
      <div class="step-flow-card reveal-on-scroll stagger-1">
        <div class="card-glass-shine" aria-hidden="true"></div>
        <div class="step-top-row">
          <span class="step-num-glow mono">01</span>
          <span class="step-badge-pill mono text-emerald">SENSOR ATTACH</span>
        </div>

        <h3 class="step-heading">Deploy MQL5 Sensor</h3>
        <p class="step-paragraph">
          Download the lightweight <code class="mono text-cyan">PipstrideMonitor.mq5</code> file directly from your console and attach it to any chart in MetaTrader 5.
        </p>

        <!-- Mini Visual Artifact -->
        <div class="step-artifact">
          <div class="artifact-header mono">
            <div class="file-info">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-emerald">
                <path d="M13 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V9z"></path>
                <polyline points="13 2 13 9 20 9"></polyline>
              </svg>
              <span class="font-bold">PipstrideMonitor.mq5</span>
            </div>
            <span class="text-muted">42 KB</span>
          </div>
          <div class="artifact-footer mono">
            <span class="secure-tag text-emerald">✓ ZERO EXECUTION PRIVILEGE</span>
          </div>
        </div>
      </div>

      <!-- Step 2 -->
      <div class="step-flow-card reveal-on-scroll stagger-2">
        <div class="card-glass-shine" aria-hidden="true"></div>
        <div class="step-top-row">
          <span class="step-num-glow mono">02</span>
          <span class="step-badge-pill mono text-cyan">AIR-GAPPED TOKEN</span>
        </div>

        <h3 class="step-heading">Paste Bridge Token</h3>
        <p class="step-paragraph">
          Generate an encrypted connection token in your dashboard and paste it into the EA inputs. Never surrender your master or investor passwords.
        </p>

        <!-- Mini Visual Artifact -->
        <div class="step-artifact">
          <div class="artifact-header mono">
            <div class="token-field">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-cyan">
                <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
                <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
              </svg>
              <span class="token-val">pst_live_948a27d1...</span>
            </div>
            <span class="copy-tag text-cyan">COPIED ✓</span>
          </div>
          <div class="artifact-footer mono">
            <span class="text-muted">0 BROKER PASSWORDS RETAINED</span>
          </div>
        </div>
      </div>

      <!-- Step 3 -->
      <div class="step-flow-card reveal-on-scroll stagger-3">
        <div class="card-glass-shine" aria-hidden="true"></div>
        <div class="step-top-row">
          <span class="step-num-glow mono">03</span>
          <span class="step-badge-pill mono text-emerald">LIVE TELEMETRY</span>
        </div>

        <h3 class="step-heading">Stream & Auto-Journal</h3>
        <p class="step-paragraph">
          Telemetry begins transmitting instantaneously to your web console and mobile cockpit. Every closed trade is auto-cataloged in real time.
        </p>

        <!-- Mini Visual Artifact -->
        <div class="step-artifact">
          <div class="artifact-header mono">
            <div class="stream-info">
              <span class="radar-dot"></span>
              <span class="font-bold text-white">ICMarketsSC-Live</span>
            </div>
            <span class="text-emerald font-bold">&lt; 8MS PING</span>
          </div>
          <div class="artifact-footer mono">
            <span class="text-emerald">AUTO-JOURNAL: ACTIVE SYNC</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .onboarding-section {
    padding: 100px 0;
    position: relative;
    overflow: hidden;
  }

  @media (max-width: 640px) {
    .onboarding-section {
      padding: 60px 0;
    }
  }

  .onboarding-glow {
    top: 30%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 600px;
    height: 400px;
    opacity: 0.7;
  }

  .text-center {
    text-align: center;
  }

  .mx-auto {
    margin-left: auto;
    margin-right: auto;
  }

  .section-header {
    margin-bottom: 56px;
    position: relative;
    z-index: 2;
  }

  .steps-flow-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
    position: relative;
    z-index: 2;
  }

  @media (max-width: 900px) {
    .steps-flow-grid {
      grid-template-columns: 1fr;
      max-width: 520px;
      margin: 0 auto;
    }
  }

  .step-flow-card {
    background: linear-gradient(180deg, rgba(17, 30, 38, 0.8) 0%, rgba(11, 20, 27, 0.95) 100%);
    border: 1px solid rgba(41, 64, 74, 0.6);
    border-radius: var(--radius-lg);
    padding: 32px 26px 26px;
    position: relative;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    box-shadow: 0 16px 40px rgba(0, 0, 0, 0.4);
    transition: transform 0.25s ease, border-color 0.25s ease, box-shadow 0.25s ease;
  }

  .step-flow-card:hover {
    transform: translateY(-4px);
    border-color: rgba(69, 224, 173, 0.45);
    box-shadow: 0 20px 50px rgba(0, 0, 0, 0.55), 0 0 24px rgba(69, 224, 173, 0.12);
  }

  .card-glass-shine {
    position: absolute;
    top: 0;
    left: 10%;
    right: 10%;
    height: 1px;
    background: linear-gradient(90deg, transparent, rgba(69, 224, 173, 0.5), transparent);
  }

  .step-top-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 20px;
  }

  .step-num-glow {
    font-size: 28px;
    font-weight: 800;
    letter-spacing: -0.03em;
    background: linear-gradient(135deg, #ffffff 30%, var(--g) 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    line-height: 1;
  }

  .step-badge-pill {
    font-size: 9.5px;
    letter-spacing: 0.12em;
    background: rgba(14, 25, 33, 0.9);
    border: 1px solid rgba(41, 64, 74, 0.7);
    padding: 4px 10px;
    border-radius: var(--radius-full);
  }

  .step-heading {
    font-size: 19px;
    font-weight: 700;
    color: var(--text);
    margin-bottom: 10px;
    letter-spacing: -0.01em;
  }

  .step-paragraph {
    font-size: 13.5px;
    line-height: 1.6;
    color: var(--text-secondary);
    margin-bottom: 24px;
    flex: 1;
  }

  /* Mini Visual Artifact Box */
  .step-artifact {
    background: #080f14;
    border: 1px solid rgba(41, 64, 74, 0.5);
    border-radius: var(--radius-sm);
    padding: 14px 16px;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .artifact-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 11px;
  }

  .file-info, .token-field, .stream-info {
    display: flex;
    align-items: center;
    gap: 7px;
  }

  .token-val {
    font-size: 11px;
    color: var(--blue);
  }

  .copy-tag {
    font-size: 9.5px;
    font-weight: 700;
  }

  .artifact-footer {
    padding-top: 8px;
    border-top: 1px solid rgba(41, 64, 74, 0.3);
    font-size: 9.5px;
    letter-spacing: 0.05em;
  }

  .secure-tag {
    font-weight: 600;
  }
</style>
