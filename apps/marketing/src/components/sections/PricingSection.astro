---
// PricingSection.astro - early-access preview with target tiers from the single-source catalog.
import { formatPrice, formatTerminals, publicPlans } from '../../lib/pricing.js';

const appUrl = 'https://app-pipstride.homever.my.id';

const plans = publicPlans.map((plan) => ({
  code: plan.code,
  name: plan.name,
  terminals: formatTerminals(plan.max_connections),
  price: formatPrice(plan.price_cents),
  highlight: plan.code === 'plus',
}));
---

<section class="section pricing-section" id="pricing">
  <div class="site-container">
    <!-- Header -->
    <div class="section-header text-center reveal-on-scroll">
      <span class="section-tag mono">SUBSCRIPTION TIERS & ACCESS</span>
      <h2 class="section-title">Transparent specifications. Honest early access.</h2>
      <p class="section-desc mx-auto">
        Paid tiers are target specifications for when billing ships. Until then the console is free to use — no checkout, no card, no automatic charges.
      </p>
    </div>

    <!-- Early Access Preview Banner (Fully Responsive) -->
    <div class="preview-hero-card reveal-on-scroll">
      <div class="preview-content">
        <div class="preview-badge mono">
          <span class="pulse-indicator"></span>
          <span>EARLY ACCESS PREVIEW</span>
        </div>
        <h3 class="preview-heading">
          Full telemetry access, <span class="gradient-text">free while billing is under construction</span>
        </h3>
        <p class="preview-sub">
          Connect your MT5 terminal, stream telemetry, and keep every journal record. Paid plans below are shown for planning only and cannot be purchased yet.
        </p>
      </div>
      <div class="preview-action">
        <a href={appUrl} class="btn-primary preview-btn" target="_blank" rel="noopener noreferrer">
          <span>Open Web Console</span>
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <line x1="7" y1="17" x2="17" y2="7"></line>
            <polyline points="7 7 17 7 17 17"></polyline>
          </svg>
        </a>
      </div>
    </div>

    <!-- 3 target plan cards from the catalog (Free tier stays internal) -->
    <div class="pricing-grid">
      {plans.map((plan, index) => (
        <div class:list={["pricing-card", `reveal-on-scroll stagger-${index + 1}`, { popular: plan.highlight }]}>
          {plan.highlight && (
            <div class="popular-ribbon mono">EARLY ACCESS // RECOMMENDED</div>
          )}

          <div class="plan-header">
            <h3 class="plan-name">{plan.name}</h3>
            <span class="plan-capacity mono text-cyan">{plan.terminals}</span>
          </div>

          <!-- Target price from the catalog, clearly marked as not purchasable -->
          <div class="price-box">
            <div class="price-value">{plan.price}<span class="price-period"> / month</span></div>
            <div class="coming-soon-pill mono">
              <span class="cs-dot"></span>
              <span>COMING SOON</span>
            </div>
          </div>

          <div class="specs-placeholder">
            <div class="specs-badge mono">
              <span class="specs-dot"></span>
              <span>Specifications coming soon</span>
            </div>
          </div>

          <div class="card-action">
            <a
              href={appUrl}
              class:list={["btn-tier", plan.highlight ? "btn-primary" : "btn-secondary"]}
              target="_blank"
              rel="noopener noreferrer"
            >
              <span>Open Web Console</span>
            </a>
          </div>
        </div>
      ))}
    </div>

    <!-- Trust Badges Strip (Responsive on mobile) -->
    <div class="trust-assurances mono">
      <span class="assurance-item"><span class="text-emerald">✓</span> NO CREDIT CARD REQUIRED</span>
      <span class="assurance-sep">•</span>
      <span class="assurance-item"><span class="text-emerald">✓</span> FREE DURING EARLY ACCESS</span>
      <span class="assurance-sep">•</span>
      <span class="assurance-item"><span class="text-emerald">✓</span> 100% READ-ONLY SENSOR</span>
      <span class="assurance-sep">•</span>
      <span class="assurance-item"><span class="text-emerald">✓</span> JOURNAL HISTORY PRESERVED</span>
    </div>
  </div>
</section>

<style>
  .pricing-section {
    padding: 90px 0;
    position: relative;
  }

  @media (max-width: 640px) {
    .pricing-section {
      padding: 60px 0;
    }
  }

  .text-center {
    text-align: center;
  }

  .mx-auto {
    margin-left: auto;
    margin-right: auto;
  }

  .section-header {
    margin-bottom: 44px;
  }

  /* Early Access Preview Card */
  .preview-hero-card {
    background: linear-gradient(135deg, rgba(23, 41, 50, 0.8) 0%, rgba(13, 23, 30, 0.95) 100%);
    border: 1px solid rgba(69, 224, 173, 0.4);
    border-radius: var(--radius-lg);
    padding: 30px 32px;
    margin-bottom: 44px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    box-shadow: 0 16px 48px rgba(0, 0, 0, 0.5), 0 0 30px rgba(69, 224, 173, 0.1);
    position: relative;
    overflow: hidden;
  }

  .preview-hero-card::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 1px;
    background: linear-gradient(90deg, transparent, var(--g), transparent);
  }

  .preview-content {
    max-width: 650px;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .preview-badge {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 10px;
    letter-spacing: 0.12em;
    color: var(--g);
    width: fit-content;
  }

  .pulse-indicator {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--g);
    animation: pulse-dot 2s infinite;
  }

  .preview-heading {
    font-size: clamp(20px, 2.5vw, 26px);
    font-weight: 700;
    color: var(--text);
    line-height: 1.25;
    letter-spacing: -0.01em;
  }

  .preview-sub {
    font-size: 14px;
    line-height: 1.6;
    color: var(--text-secondary);
  }

  .preview-btn {
    padding: 12px 24px;
    font-size: 14.5px;
    white-space: nowrap;
  }

  @media (max-width: 800px) {
    .preview-hero-card {
      padding: 24px 20px;
      flex-direction: column;
      align-items: stretch;
      gap: 20px;
    }
    .preview-action {
      width: 100%;
    }
    .preview-btn {
      width: 100%;
      text-align: center;
      justify-content: center;
    }
  }

  /* Pricing Grid */
  .pricing-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
    margin-bottom: 36px;
  }

  @media (max-width: 992px) {
    .pricing-grid {
      grid-template-columns: 1fr;
      max-width: 480px;
      margin-left: auto;
      margin-right: auto;
    }
  }

  .pricing-card {
    background: #111e26;
    border: 1px solid rgba(41, 64, 74, 0.55);
    border-radius: var(--radius-md);
    padding: 30px 24px;
    display: flex;
    flex-direction: column;
    position: relative;
    transition: all 0.25s ease;
  }

  @media (max-width: 640px) {
    .pricing-card {
      padding: 26px 20px;
    }
  }

  .pricing-card.popular {
    border-color: rgba(69, 224, 173, 0.5);
    background: linear-gradient(180deg, rgba(23, 41, 50, 0.7) 0%, rgba(17, 30, 38, 0.9) 100%);
    box-shadow: 0 20px 60px -15px rgba(0, 0, 0, 0.6), 0 0 30px rgba(69, 224, 173, 0.12);
  }

  .popular-ribbon {
    position: absolute;
    top: -12px;
    left: 50%;
    transform: translateX(-50%);
    background: var(--g);
    color: #080f14;
    font-size: 10px;
    font-weight: 800;
    letter-spacing: 0.08em;
    padding: 3px 12px;
    border-radius: var(--radius-full);
    white-space: nowrap;
  }

  .plan-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 18px;
  }

  .plan-name {
    font-size: 24px;
    font-weight: 800;
    color: var(--text);
    letter-spacing: -0.02em;
  }

  .plan-capacity {
    font-size: 11px;
    font-weight: 600;
    background: rgba(131, 189, 255, 0.1);
    border: 1px solid rgba(131, 189, 255, 0.3);
    padding: 3px 8px;
    border-radius: var(--radius-xs);
  }

  .price-box {
    background: #091218;
    border: 1px solid rgba(41, 64, 74, 0.4);
    border-radius: var(--radius-sm);
    padding: 14px 16px;
    margin-bottom: 22px;
    text-align: center;
  }

  .price-value {
    font-size: 26px;
    font-weight: 800;
    color: var(--text);
    letter-spacing: -0.02em;
    line-height: 1.2;
  }

  .price-period {
    font-size: 11px;
    font-weight: 500;
    color: var(--muted);
    letter-spacing: 0;
  }

  .coming-soon-pill {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.1em;
    color: var(--blue);
    margin-top: 6px;
  }

  .cs-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--blue);
  }

  .specs-placeholder {
    flex: 1;
    min-height: 120px;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 24px 16px;
    margin-bottom: 28px;
    border: 1px dashed rgba(41, 64, 74, 0.45);
    border-radius: var(--radius-sm);
    background: rgba(9, 18, 24, 0.35);
    text-align: center;
  }

  .specs-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.04em;
    color: var(--muted);
  }

  .specs-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--muted);
    opacity: 0.6;
  }

  @media (max-width: 640px) {
    .specs-placeholder {
      min-height: 80px;
      padding: 16px 12px;
      margin-bottom: 22px;
    }
  }

  .card-action {
    margin-top: auto;
  }

  .btn-tier {
    width: 100%;
    padding: 11px 16px;
    text-align: center;
    font-size: 13.5px;
    font-weight: 600;
    text-decoration: none;
    border-radius: var(--radius-sm);
    display: block;
    box-sizing: border-box;
  }

  .trust-assurances {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 14px;
    font-size: 11px;
    color: var(--muted);
    flex-wrap: wrap;
    text-align: center;
    line-height: 1.8;
  }

  @media (max-width: 640px) {
    .assurance-sep {
      display: none;
    }
    .assurance-item {
      display: block;
      width: 100%;
    }
  }

  .assurance-sep {
    color: rgba(41, 64, 74, 0.6);
  }
</style>
