---
// MetricsStrip.astro - Live Performance Metrics Strip
---

<section class="metrics-strip-section" aria-label="System Metrics">
  <div class="site-container">
    <div class="metrics-strip-grid reveal-on-scroll">
      <div class="stat-box">
        <div class="stat-number mono text-emerald font-bold">&lt; 8ms</div>
        <div class="stat-label">INGEST LATENCY</div>
        <div class="stat-sub text-muted">Sub-second Redis live state</div>
      </div>

      <div class="stat-box">
        <div class="stat-number mono text-emerald font-bold">0</div>
        <div class="stat-label">EXECUTION PRIVILEGE</div>
        <div class="stat-sub text-muted">Zero risk of order execution</div>
      </div>

      <div class="stat-box">
        <div class="stat-number mono text-cyan font-bold">100%</div>
        <div class="stat-label">AUTOMATIC SYNC</div>
        <div class="stat-sub text-muted">Zero manual journal entry</div>
      </div>

      <div class="stat-box">
        <div class="stat-number mono text-cyan font-bold">99.9%</div>
        <div class="stat-label">SYSTEM UPTIME</div>
        <div class="stat-sub text-muted">24/5 global terminal coverage</div>
      </div>
    </div>
  </div>
</section>

<style>
  .metrics-strip-section {
    padding: 48px 0;
    background: #091218;
    border-bottom: 1px solid var(--border-subtle);
  }

  .metrics-strip-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 20px;
  }

  @media (max-width: 768px) {
    .metrics-strip-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 24px;
    }
  }

  @media (max-width: 640px) {
    .metrics-strip-section {
      padding: 32px 0;
    }
    .metrics-strip-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 16px 8px;
    }
    .stat-box {
      padding: 4px;
    }
    .stat-number {
      font-size: 25px !important;
    }
    .stat-label {
      font-size: 10px;
    }
    .stat-sub {
      font-size: 9.5px;
    }
  }

  .stat-box {
    text-align: center;
    padding: 12px;
  }

  .stat-number {
    font-size: clamp(32px, 3.5vw, 44px);
    letter-spacing: -0.02em;
    line-height: 1.1;
    margin-bottom: 6px;
  }

  .stat-label {
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.12em;
    color: var(--text);
    margin-bottom: 4px;
  }

  .stat-sub {
    font-size: 11.5px;
  }
</style>
