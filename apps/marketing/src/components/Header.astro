---
// Header.astro - Clean Modern Glassmorphic Navbar for Pipstride with Official Logo
interface Props {
  currentPath?: string;
}

const { currentPath = '/' } = Astro.props;
const appUrl = 'https://app-pipstride.homever.my.id';
---

<header class="console-header">
  <div class="site-container header-inner">
    <!-- Brand with Official Pipstride Logo -->
    <a href="/" class="brand-link" aria-label="Pipstride Home">
      <div class="brand-logo-box">
        <img src="/favicon.svg" alt="Pipstride Logo" class="brand-logo-img" width="28" height="27" loading="eager" decoding="async" />
      </div>
      <div class="brand-text">
        <span class="brand-title">Pipstride</span>
      </div>
    </a>

    <!-- Navigation Links -->
    <nav class="console-nav" aria-label="Main Navigation">
      <a href="/#features" class="nav-item">Features</a>
      <a href="/#journal-analytics" class="nav-item">Journal Analytics</a>
      <a href="/#how-it-works" class="nav-item">How It Works</a>
      <a href="/#pricing" class="nav-item">Pricing</a>
      <a href="/#faq" class="nav-item">FAQ</a>
    </nav>

    <!-- Console Launch CTA -->
    <div class="header-actions">
      <a href={appUrl} class="btn-primary launch-cta" target="_blank" rel="noopener noreferrer">
        <span>Launch Console</span>
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <line x1="7" y1="17" x2="17" y2="7"></line>
          <polyline points="7 7 17 7 17 17"></polyline>
        </svg>
      </a>
    </div>
  </div>
</header>

<style>
  .console-header {
    position: sticky;
    top: 0;
    z-index: 50;
    width: 100%;
    background: rgba(7, 12, 16, 0.88);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border-bottom: 1px solid var(--border-subtle);
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 68px;
    gap: 16px;
  }

  @media (max-width: 640px) {
    .header-inner {
      height: 58px;
    }
  }

  .brand-link {
    display: flex;
    align-items: center;
    gap: 10px;
    text-decoration: none;
    color: var(--text);
  }

  .brand-logo-box {
    width: 28px;
    height: 28px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .brand-logo-img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    display: block;
  }

  .brand-text {
    display: flex;
    align-items: center;
  }

  .brand-title {
    font-size: 17px;
    font-weight: 700;
    letter-spacing: -0.02em;
    color: var(--text);
    line-height: 1;
  }

  .console-nav {
    display: flex;
    align-items: center;
    gap: 26px;
  }

  @media (max-width: 860px) {
    .console-nav {
      display: none;
    }
  }

  .nav-item {
    font-size: 13.5px;
    font-weight: 500;
    color: var(--text-secondary);
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .nav-item:hover {
    color: var(--g);
  }

  .header-actions {
    display: flex;
    align-items: center;
    flex-shrink: 0;
  }

  .launch-cta {
    padding: 8px 16px;
    font-size: 13px;
  }

  @media (max-width: 640px) {
    .launch-cta {
      padding: 7px 12px;
      font-size: 12px;
      gap: 5px;
    }
  }
</style>
