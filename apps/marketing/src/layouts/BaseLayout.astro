---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/tokens.css';
import '../styles/motion.css';

interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  ogType?: string;
}

const {
  title = 'Pipstride — The Zero-Execution MT5 Telemetry Engine',
  description = 'High-frequency MetaTrader 5 telemetry streaming and automated trade journaling. Engineered strictly read-only with zero order execution capabilities.',
  canonical,
  ogType = 'website',
} = Astro.props;

const canonicalURL = canonical || new URL(Astro.url.pathname, Astro.site || 'https://pipstride.homever.my.id').href;
const currentPath = Astro.url.pathname;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonicalURL} />
    <meta name="generator" content={Astro.generator} />

    <!-- Primary Meta Tags -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#070c10" />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="Pipstride" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:image" content={new URL('/favicon.svg', Astro.site || 'https://pipstride.homever.my.id').href} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalURL} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL('/favicon.svg', Astro.site || 'https://pipstride.homever.my.id').href} />

    <!-- Google Fonts: Outfit & JetBrains Mono -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;600&family=Outfit:wght@300;400;500;600;700;800&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="cinematic-canvas">
    <Header currentPath={currentPath} />
    <main class="main-content" id="main-content">
      <slot />
    </main>
    <Footer />

    <!-- Lightweight Scroll-Triggered Reveal Animation (Vanilla IntersectionObserver, Zero Overhead) -->
    <script is:inline>
      (function() {
        if (typeof window === 'undefined') return;
        const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        if (prefersReduced) {
          document.querySelectorAll('.reveal-on-scroll').forEach(el => el.classList.add('is-visible'));
          return;
        }

        const observer = new IntersectionObserver((entries, obs) => {
          entries.forEach(entry => {
            if (entry.isIntersecting) {
              entry.target.classList.add('is-visible');
              obs.unobserve(entry.target);
            }
          });
        }, {
          threshold: 0.08,
          rootMargin: '0px 0px -40px 0px'
        });

        document.querySelectorAll('.reveal-on-scroll').forEach(el => observer.observe(el));
      })();
    </script>
  </body>
</html>

<style>
  .main-content {
    flex: 1;
    display: flex;
    flex-direction: column;
    width: 100%;
  }
</style>
