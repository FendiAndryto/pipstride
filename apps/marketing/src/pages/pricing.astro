---
import BaseLayout from '../layouts/BaseLayout.astro';
import PricingSection from '../components/sections/PricingSection.astro';
import FaqSection from '../components/sections/FaqSection.astro';
import CtaBanner from '../components/sections/CtaBanner.astro';
import { priceRange, publicPlans } from '../lib/pricing.js';

// Billing is not implemented: prices are published as pre-order targets only.
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  'name': 'Pipstride Telemetry Engine',
  'description': 'Real-time read-only MetaTrader 5 account telemetry streaming and automated journal ledger.',
  'offers': {
    '@type': 'AggregateOffer',
    'priceCurrency': 'IDR',
    'lowPrice': String(priceRange.low),
    'highPrice': String(priceRange.high),
    'offerCount': String(priceRange.count),
    'offers': publicPlans.map((plan) => ({
      '@type': 'Offer',
      'name': plan.name,
      'price': String(plan.price_cents / 100),
      'priceCurrency': 'IDR',
      'availability': 'https://schema.org/PreOrder',
    })),
  },
};
---

<BaseLayout
  title="Pricing & Early Access Preview — Pipstride"
  description="Compare Pipstride terminal limits and target subscription prices in IDR. Early access is free while billing is under construction — no checkout."
>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

  <div class="pricing-page-wrap">
    <PricingSection />
    <FaqSection />
    <CtaBanner />
  </div>
</BaseLayout>

<style>
  .pricing-page-wrap {
    padding-top: 20px;
  }
</style>
