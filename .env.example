# ==========================================
# Pipstride Configuration Template
# ==========================================
# Copy to .env and fill in real values. Never commit the real .env.

# Runtime
ENVIRONMENT=development

# Ports
WEB_PORT=3000
MARKETING_PORT=3001
ADMIN_PORT=3002
API_PORT=8089

# Host interface the web/marketing containers publish on. Loopback is right when
# the reverse proxy runs inside this compose project; set it to the host's LAN or
# VPN address when the proxy lives outside (a proxy in another container or on
# another machine cannot reach 127.0.0.1).
WEB_BIND_IP=127.0.0.1
MARKETING_BIND_IP=127.0.0.1
ADMIN_BIND_IP=127.0.0.1
POSTGRES_PORT=5432
REDIS_PORT=6379

# Production Domain (used with Caddy auto-TLS: docker-compose.prod.yml)
# Set to dashboard subdomain, e.g. app-pipstride.homever.my.id or app.pipstride.com
PIPSTRIDE_DOMAIN=localhost
MARKETING_DOMAIN=localhost
# Admin console: a separate origin and bundle (ADR 0008 §7). It is gated by an
# IP allowlist at the proxy; add the hostname to ALLOWED_HOSTS in production.
ADMIN_DOMAIN=localhost
ADMIN_ALLOWED_IPS=127.0.0.1/32

# Persistence (PostgreSQL is required outside local development)
DATABASE_URL=postgresql+psycopg://pipstride:pipstride_dev_password@127.0.0.1:5432/pipstride
POSTGRES_DB=pipstride
POSTGRES_USER=pipstride
POSTGRES_PASSWORD=pipstride_dev_password

# Shared live telemetry cache (leave empty to use the in-process fallback)
REDIS_URL=redis://127.0.0.1:6379/0

# Security (generate with: python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=change-me-to-a-secure-random-32-byte-hex
ACCESS_TOKEN_EXPIRE_MINUTES=1440
# Comma-separated Host header allow-list, enforced by TrustedHostMiddleware.
# localhost/127.0.0.1/[::1] are always allowed for the container healthcheck.
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Default trial duration for public self-registration (SPEC-004). <= 0 disables trial (lifetime).
DEFAULT_REGISTRATION_TRIAL_DAYS=3

# Admin Seed Account
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_this_password

# Admin console security (ADR 0008 §5/§6)
# TOTP_ENCRYPTION_KEY encrypts users.totp_secret at rest. Any >=32-char secret
# works; generate with `python -c "import secrets; print(secrets.token_hex(32))"`.
# When empty the seed is encrypted with a key derived from SECRET_KEY, which
# means rotating SECRET_KEY forces every privileged account to re-enroll.
TOTP_ENCRYPTION_KEY=
TOTP_ISSUER=Pipstride
# Support mode is a 30-minute, reason-required elevation whose grant, detail
# view and revoke are visible in the user's own access log. Keep this false
# until that access log is deployed and verified.
SUPPORT_MODE_ENABLED=false
SUPPORT_SESSION_MINUTES=30

# MT5 Bridge Settings
MT5_MAGIC_NUMBER=778899
BRIDGE_POLL_INTERVAL_MS=500
HEARTBEAT_TIMEOUT_SECONDS=10

# Transactional email (password reset + address verification).
# Without SMTP_HOST, messages are logged instead of sent (development only).
# In production, set a real relay so recovery links reach users.
PUBLIC_APP_URL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=Pipstride <no-reply@pipstride.local>
SMTP_STARTTLS=true
EMAIL_RESET_TTL_MINUTES=30
EMAIL_VERIFY_TTL_HOURS=24

# Onboarding package (.set preset) generated at token create/rotate time.
# PUBLIC_BASE_URL is the public origin the EA must reach, e.g. https://pipstride.app.
# Leave empty to derive it from the dashboard request.
PUBLIC_BASE_URL=
MT5_MONITORED_SYMBOLS=XAUUSD,EURUSD,GBPUSD,USDJPY,BTCUSD
# 5s keeps the dashboard live while cutting heartbeat ingest and CPU load.
MT5_HEARTBEAT_INTERVAL_SECONDS=5
MT5_HISTORY_DAYS=90

# Abuse protection (Redis-backed when REDIS_URL is set)
RATE_LIMIT_ENABLED=true
HEARTBEAT_RATE_LIMIT=120
HEARTBEAT_RATE_WINDOW_SECONDS=10

# Raw telemetry retention (see docs/adr/0005-telemetry-snapshot-retention.md)
SNAPSHOT_RETENTION_DAYS=180

# Logging
LOG_LEVEL=INFO

# API worker count for docker compose. Two workers fit a dual-core homeserver;
# raise only if the host has spare CPU and RAM.
UVICORN_WORKERS=2

# Risk Watchdog Defaults (Passive Monitoring)
DEFAULT_RISK_PER_TRADE_PERCENT=1.0
MAX_RISK_PER_TRADE_PERCENT=10.0
MAX_DAILY_DRAWDOWN_PERCENT=3.0
MAX_SPREAD_POINTS=35
MIN_LOT_SIZE=0.01
MAX_LOT_SIZE=100.0

# Telegram Watchdog Alerts (Optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_NOTIFICATIONS_ENABLED=true
