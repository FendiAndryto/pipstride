# ==========================================
# Pipstride Configuration Template
# ==========================================
# Copy to .env and fill in real values. Never commit the real .env.

# Runtime
ENVIRONMENT=development

# Ports
WEB_PORT=3000
API_PORT=8089
POSTGRES_PORT=5432
REDIS_PORT=6379

# Persistence (PostgreSQL is required outside local development)
DATABASE_URL=postgresql+psycopg://pipstride:pipstride_dev_password@127.0.0.1:5432/pipstride
POSTGRES_DB=pipstride
POSTGRES_USER=pipstride
POSTGRES_PASSWORD=pipstride_dev_password

# Shared live telemetry cache (leave empty to use the in-process fallback)
REDIS_URL=redis://127.0.0.1:6379/0

# Security (generate with: python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=change-me-to-a-secure-random-32-byte-hex
ACCESS_TOKEN_EXPIRE_MINUTES=1440
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Admin Seed Account
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_this_password

# MT5 Bridge Settings
MT5_MAGIC_NUMBER=778899
BRIDGE_POLL_INTERVAL_MS=500
HEARTBEAT_TIMEOUT_SECONDS=10

# Risk Watchdog Defaults (Passive Monitoring)
DEFAULT_RISK_PER_TRADE_PERCENT=1.0
MAX_RISK_PER_TRADE_PERCENT=10.0
MAX_DAILY_DRAWDOWN_PERCENT=3.0
MAX_SPREAD_POINTS=35
MIN_LOT_SIZE=0.01
MAX_LOT_SIZE=100.0

# Telegram Watchdog Alerts (Optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_NOTIFICATIONS_ENABLED=true
