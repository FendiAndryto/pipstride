# Pipstride Production Reverse Proxy (Caddy with Automatic HTTPS / Let's Encrypt)
# Set PIPSTRIDE_DOMAIN in .env (e.g. PIPSTRIDE_DOMAIN=journal.yourdomain.com)

{$PIPSTRIDE_DOMAIN:localhost} {
    encode gzip zstd

    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "strict-origin-when-cross-origin"
        Permissions-Policy "geolocation=(), microphone=(), camera=()"
    }

    # Route all traffic to web (nginx serves SPA and proxies /api to FastAPI)
    reverse_proxy web:80
}
