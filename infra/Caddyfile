# Pipstride Production Reverse Proxy (Caddy with Automatic HTTPS / Let's Encrypt)
# Set PIPSTRIDE_DOMAIN and MARKETING_DOMAIN in .env
#
# Trust chain: client → Cloudflare → Caddy → web nginx → api.
# Cloudflare is the only trusted edge; Caddy resolves the real client IP
# via CF-Connecting-IP; nginx trusts only Caddy's X-Real-IP.

{
    servers {
        trusted_proxies static 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
        client_ip_headers CF-Connecting-IP
    }
}

# 1. Apex Domain: Public marketing site (purely static, zero auth/cookies)
{$MARKETING_DOMAIN:pipstride.homever.my.id} {
    encode gzip zstd

    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "strict-origin-when-cross-origin"
        Permissions-Policy "geolocation=(), microphone=(), camera=()"
    }

    reverse_proxy marketing:80
}

# 2. Product Subdomain: Authenticated web console & API
{$PIPSTRIDE_DOMAIN:app-pipstride.homever.my.id} {
    encode gzip zstd

    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "strict-origin-when-cross-origin"
        Permissions-Policy "geolocation=(), microphone=(), camera=()"
    }

    # Route all traffic to web (nginx serves SPA and proxies /api to FastAPI)
    reverse_proxy web:80 {
        header_up X-Real-IP {client_ip}
    }
}
