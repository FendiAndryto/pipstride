[importlinter]
root_package = app
include_external_packages = true

# ---------------------------------------------------------------------------
# Layered architecture for services/api/app.
#
# Target layout (ADR 0009 §3):
#   app/interfaces/    -> api/v1 routers, schemas, deps (currently app/api/v1,
#                         app/models, app/core/deps.py)
#   app/infrastructure/ -> db, cache, email, telegram (currently app/db,
#                         app/core/live_state.py, app/core/logging.py,
#                         app/core/rate_limit.py, app/services/email_service.py,
#                         app/services/telegram_service.py)
#   app/domain/        -> pure business rules (not created yet; Fase 005)
#
# Because the target layers do not exist, this contract enforces the import
# direction that is already true today and must stay true as code moves:
#   * app.services may not import app.api.v1 (the HTTP layer).
#   * app.db (persistence models) may not import app.services or app.api.v1.
#   * app.models (Pydantic DTOs) may not import app.db, app.services or app.api.v1.
#   * app.services.bridge_service is the only service that currently imports
#     fastapi; the contract below flags it as a baseline to remove in Fase 005.
#   * SQLAlchemy/redis are allowed in the boundary modules listed below.
#
# TODO(Fase 005): replace these path-based contracts with explicit
#   domain / infrastructure / interfaces packages once they are created.
# ---------------------------------------------------------------------------

[importlinter:contract:no-services-import-api]
name = Services never import the HTTP layer (api/v1)
type = forbidden
source_modules =
    app.services
forbidden_modules =
    app.api.v1

[importlinter:contract:no-db-import-services-or-api]
name = DB models never import services or the HTTP layer
type = forbidden
source_modules =
    app.db
forbidden_modules =
    app.services
    app.api.v1

[importlinter:contract:no-models-import-db-services-api]
name = Pydantic DTOs never import DB, services or the HTTP layer
type = forbidden
source_modules =
    app.models
forbidden_modules =
    app.db
    app.services
    app.api.v1

[importlinter:contract:no-fastapi-in-services]
name = fastapi is not imported by the service layer (Fase 005 baseline)
type = forbidden
source_modules =
    app.services
forbidden_modules =
    fastapi

# TODO(Fase 005): activate once app.domain/ is created.
# [importlinter:contract:no-sqlalchemy-in-domain]
# name = SQLAlchemy is forbidden inside the pure domain layer
# type = forbidden
# source_modules =
#     app.domain
# transitive = false
# forbidden_modules =
#     sqlalchemy

# Redis contract: the `redis` module is only allowed inside app.core.live_state
# and app.core.rate_limit. import-linter does not distinguish "imports the
# adapter" from "imports the external package the adapter wraps", so the strict
# contract would flag every router and service that uses live state or rate
# limiting. We therefore accept the current arrangement as a documented
# baseline: app.core owns redis, and no module outside app.core imports redis
# directly. A custom contract type is not available, so this is enforced by the
# code review / CI baseline rather than by import-linter directly.
# TODO(Fase 005): move redis adapters to app.infrastructure/ and restore a
# strict forbidden contract from app.domain/app.services/app.api.v1 to redis.

# Operational scripts live under the top-level scripts/ directory, not app.scripts.
# They already do not import redis; this contract is documented in ADR 0009.
